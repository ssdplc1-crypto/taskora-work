FLASK_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-strong-admin-password
BASE_URL=http://localhost:5000
COOKIE_SECURE=0

# PostgreSQL (recommended for Render). Leave blank locally to use SQLite.
DATABASE_URL=
PGSSLMODE=require

# Flutterwave LIVE credentials. Never commit real secrets to GitHub.
FLW_SECRET_KEY=FLWSECK_LIVE-xxxxxxxxxxxxxxxx
FLW_WEBHOOK_HASH=your-webhook-secret-hash
